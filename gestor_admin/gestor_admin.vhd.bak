library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity gestor_admin is
    port(
        clk          : in  std_logic;
        rst          : in  std_logic;
        tecla        : in  std_logic_vector(3 downto 0);
        tecla_valida : in  std_logic;

        mem_address  : out std_logic_vector(5 downto 0);
        mem_dato_in  : out std_logic_vector(7 downto 0);
        mem_we       : out std_logic;

        modo_admin   : out std_logic;
        display_out  : out std_logic_vector(3 downto 0)
    );
end gestor_admin;

architecture rtl of gestor_admin is

    type estado_admin_t is (
        ESPERA,           -- esperando *
        CLAVE_ADMIN,      -- ingresando 2308
        ADMIN_OK,         -- modo admin activo
        OP_AGREGAR_USR,   -- recibió letra de usuario
        OP_AGREGAR_CLV,   -- ingresando 4 dígitos de clave
        OP_AGREGAR_HOR,   -- ingresando horario (0-3)
        OP_ELIMINAR_USR,  -- esperando letra de usuario a eliminar
        ESCRIBIENDO       -- grabando en RAM (6 ciclos)
    );

    signal estado : estado_admin_t := ESPERA;

    -- clave admin 2308
    type clave_t is array (0 to 3) of std_logic_vector(3 downto 0);
    constant CLAVE_ADMIN : clave_t := (x"2", x"3", x"0", x"8");

    signal digito_admin  : integer range 0 to 3 := 0;
    signal usuario_sel   : integer range 0 to 3 := 0;
    signal clave_buf     : clave_t := (others => x"0");
    signal digito_clave  : integer range 0 to 3 := 0;
    signal horario_buf   : std_logic_vector(7 downto 0) := (others => '0');

    signal write_step    : integer range 0 to 5 := 0;
    signal es_eliminar   : std_logic := '0';

    signal we_i          : std_logic := '0';
    signal addr_i        : std_logic_vector(5 downto 0) := (others => '0');
    signal dato_i        : std_logic_vector(7 downto 0) := (others => '0');

    signal base_addr     : integer range 0 to 63 := 0;

begin

    base_addr <= 6 + usuario_sel * 6;

    process(clk, rst)
    begin
        if rst = '1' then
            estado       <= ESPERA;
            digito_admin <= 0;
            digito_clave <= 0;
            usuario_sel  <= 0;
            write_step   <= 0;
            es_eliminar  <= '0';
            we_i         <= '0';
            addr_i       <= (others => '0');
            dato_i       <= (others => '0');

        elsif rising_edge(clk) then
            we_i <= '0';

            case estado is

                -- espera que se presione *
                when ESPERA =>
                    if tecla_valida = '1' and tecla = x"E" then
                        estado       <= CLAVE_ADMIN;
                        digito_admin <= 0;
                    end if;

                -- valida los 4 dígitos de 2308
                when CLAVE_ADMIN =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then          -- # cancela
                            estado <= ESPERA;
                        elsif tecla <= x"9" then
                            if tecla = CLAVE_ADMIN(digito_admin) then
                                if digito_admin = 3 then
                                    estado       <= ADMIN_OK;
                                    digito_admin <= 0;
                                else
                                    digito_admin <= digito_admin + 1;
                                end if;
                            else
                                -- dígito incorrecto, volver al inicio
                                estado       <= ESPERA;
                                digito_admin <= 0;
                            end if;
                        end if;
                    end if;

                -- modo admin activo: espera operación
                -- A/B/C/D → agregar o modificar usuario
                -- # → salir
                when ADMIN_OK =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then          -- # salir
                            estado <= ESPERA;

                        elsif tecla = x"A" or tecla = x"B" or
                              tecla = x"C" or tecla = x"D" then
                            case tecla is
                                when x"A" => usuario_sel <= 0;
                                when x"B" => usuario_sel <= 1;
                                when x"C" => usuario_sel <= 2;
                                when others => usuario_sel <= 3;
                            end case;
                            digito_clave <= 0;
                            es_eliminar  <= '0';
                            estado       <= OP_AGREGAR_USR;

                        elsif tecla = x"E" then       -- * → eliminar usuario
                            es_eliminar <= '1';
                            estado      <= OP_ELIMINAR_USR;
                        end if;
                    end if;

                -- recibió letra, espera primer dígito de clave
                when OP_AGREGAR_USR =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then
                            estado <= ADMIN_OK;
                        elsif tecla <= x"9" then
                            clave_buf(0) <= tecla;
                            digito_clave <= 1;
                            estado       <= OP_AGREGAR_CLV;
                        end if;
                    end if;

                -- recibe dígitos 2, 3 y 4 de la clave
                when OP_AGREGAR_CLV =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then
                            estado <= ADMIN_OK;
                        elsif tecla <= x"9" then
                            clave_buf(digito_clave) <= tecla;
                            if digito_clave = 3 then
                                estado <= OP_AGREGAR_HOR;
                            else
                                digito_clave <= digito_clave + 1;
                            end if;
                        end if;
                    end if;

                -- recibe horario: 0=mañana 1=tarde 2=noche 3=fin semana
                when OP_AGREGAR_HOR =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then
                            estado <= ADMIN_OK;
                        elsif tecla <= x"3" then
                            horario_buf <= x"0" & tecla;
                            write_step  <= 0;
                            estado      <= ESCRIBIENDO;
                        end if;
                    end if;

                -- escribe 6 bytes consecutivos en RAM
                when ESCRIBIENDO =>
                    case write_step is
                        when 0 =>  -- ID usuario
                            addr_i     <= std_logic_vector(to_unsigned(base_addr, 6));
                            dato_i     <= std_logic_vector(to_unsigned(usuario_sel, 8));
                            we_i       <= '1';
                            write_step <= 1;
                        when 1 =>  -- horario
                            addr_i     <= std_logic_vector(to_unsigned(base_addr + 1, 6));
                            dato_i     <= horario_buf;
                            we_i       <= '1';
                            write_step <= 2;
                        when 2 =>  -- dígito 1
                            addr_i     <= std_logic_vector(to_unsigned(base_addr + 2, 6));
                            dato_i     <= x"0" & clave_buf(0);
                            we_i       <= '1';
                            write_step <= 3;
                        when 3 =>  -- dígito 2
                            addr_i     <= std_logic_vector(to_unsigned(base_addr + 3, 6));
                            dato_i     <= x"0" & clave_buf(1);
                            we_i       <= '1';
                            write_step <= 4;
                        when 4 =>  -- dígito 3
                            addr_i     <= std_logic_vector(to_unsigned(base_addr + 4, 6));
                            dato_i     <= x"0" & clave_buf(2);
                            we_i       <= '1';
                            write_step <= 5;
                        when 5 =>  -- dígito 4
                            addr_i     <= std_logic_vector(to_unsigned(base_addr + 5, 6));
                            dato_i     <= x"0" & clave_buf(3);
                            we_i       <= '1';
                            write_step <= 0;
                            estado     <= ADMIN_OK;
                    end case;

                -- marca el usuario como eliminado (ID = 0xFF)
                when OP_ELIMINAR_USR =>
                    if tecla_valida = '1' then
                        if tecla = x"F" then
                            estado <= ADMIN_OK;
                        elsif tecla = x"A" or tecla = x"B" or
                              tecla = x"C" or tecla = x"D" then
                            case tecla is
                                when x"A" => usuario_sel <= 0;
                                when x"B" => usuario_sel <= 1;
                                when x"C" => usuario_sel <= 2;
                                when others => usuario_sel <= 3;
                            end case;
                            addr_i  <= std_logic_vector(to_unsigned(base_addr, 6));
                            dato_i  <= x"FF";
                            we_i    <= '1';
                            estado  <= ADMIN_OK;
                        end if;
                    end if;

                when others =>
                    estado <= ESPERA;

            end case;
        end if;
    end process;

    mem_address <= addr_i;
    mem_dato_in <= dato_i;
    mem_we      <= we_i;

    modo_admin  <= '0' when estado = ESPERA else '1';

    display_out <= std_logic_vector(to_unsigned(usuario_sel, 4))
                   when estado = OP_AGREGAR_USR or
                        estado = OP_AGREGAR_CLV or
                        estado = OP_AGREGAR_HOR  or
                        estado = OP_ELIMINAR_USR
                   else x"F";

end rtl;